# ====================================================================
# Ludo X BD - Google Play Upload Keystore Configuration Template
# ====================================================================
# Copy this file to "keystore.properties" and set your own secure credentials.
# IMPORTANT: "keystore.properties" and "*.jks" are in .gitignore and must
# NEVER be shared publicly, committed to git, or sent to untrusted parties.
#
KEYSTORE_PATH=upload-keystore.jks
KEYSTORE_PASSWORD=YourSecureKeystorePassword
KEY_ALIAS=upload
KEY_PASSWORD=YourSecureKeyPassword
